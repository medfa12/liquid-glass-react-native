  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true,
    "declaration": true, "outDir": "lib", "skipLibCheck": true,
    "esModuleInterop": true, "noUnusedLocals": true
  },
  "include": ["src"]
